rules_version = '2';
// Edit 1 Job Board: one shared board per stage, open only to the people on
// the access list. The access list is the document access/members
// ({ emails: ["name@example.com", ...] }, lower case), edited by the owner in
// the Firebase console; it is never written by the app or kept in the repo.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function member() {
      return signedIn()
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/access/members).data.emails;
    }
    function validStage(stage) { return stage in ['local', 'dev', 'alpha', 'staging', 'main']; }

    // Every save: the payload (JSON text), the next revision number, an id
    // for safe retries, server time and who saved. Nothing else.
    function validSave() {
      let d = request.resource.data;
      return d.keys().hasOnly(['payload', 'revision', 'mutationId', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['payload', 'revision', 'mutationId', 'updatedAt', 'updatedBy'])
        && d.payload is string && d.payload.size() > 0 && d.payload.size() <= 900000
        && d.mutationId is string && d.mutationId.size() > 0 && d.mutationId.size() <= 100
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid
        && d.revision is int
        && d.revision == (resource == null ? 1 : resource.data.revision + 1);
    }

    // Members can check they're on the list; nobody can change it from the app.
    match /access/members {
      allow get: if member();
    }

    // The shared board, one document per day (YYYY-MM-DD).
    match /stages/{stage}/boards/{date} {
      allow read: if member() && validStage(stage);
      allow create, update: if member() && validStage(stage)
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validSave();
    }

    // Each member's own checklist.
    match /stages/{stage}/tasks/{uid} {
      allow get: if member() && validStage(stage) && request.auth.uid == uid;
      allow create, update: if member() && validStage(stage) && request.auth.uid == uid && validSave();
    }

    // "Report issue" (issue #27; playbook report-issue.md): testers add a
    // report; nobody reads, edits or deletes reports from the app (a GitHub
    // Action with admin access turns them into issues and emails the tester).
    // Testers list: access/testers { emails: [lower-case addresses] }, edited
    // in the Firebase console, never in the repo; not readable from the app.
    function tester() {
      return signedIn()
        && exists(/databases/$(database)/documents/access/testers)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/access/testers).data.emails;
    }
    match /issueReports/{reportId} {
      allow create: if tester()
        && request.resource.data.keys().hasOnly(['title', 'body', 'type', 'stage', 'uid', 'email', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['title', 'body', 'type', 'stage', 'uid', 'email', 'status', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 5000
        && (request.resource.data.type == null || request.resource.data.type in ['bug', 'feature', 'tweak', 'performance'])
        && validStage(request.resource.data.stage)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }
  }
}
